# Xcode / build
build/
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/
*.xcuserstate
.DS_Store

# Generated by xcodegen (project.yml is source of truth)
Dobby.xcodeproj/

# Carthage / SPM / deps build artifacts
Carthage/Build/
.swiftpm/

# Local build output dirs (xcodebuild -derivedDataPath / SYMROOT)
build/
build-ios/
build-mac/
.omc/

# Build-time copy of the PWA app shell (scripts/copy-app-shell.sh, #151). Generated
# from the sibling ../dobby checkout on every build; only the folder itself is tracked,
# so xcodegen's folder reference has something to point at on a fresh clone.
Dobby/Shell/*
!Dobby/Shell/.gitkeep

# Agent scratch/evidence, never published
.claude-work/
