<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode's INFOPLIST_KEY_ synthesis silently drops. Synthesized keys
	     (display name, scene manifest, etc.) merge on top of this base. -->
	<!-- No custom/proprietary crypto → skip TestFlight's per-build export-compliance prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Now Playing Live Activity: lock screen, Dynamic Island, and the CarPlay
	     Dashboard (which renders Live Activities with no CarPlay entitlement). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The LAN address of the server is plain HTTP (only the Tailscale name is
	     fronted by `tailscale serve`), so cleartext to local hosts must be allowed
	     or the app can never use the direct home-network address. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dobby connects directly to your home server when you are on the same network.</string>
	<!-- App-Bound Domains: opting in turns on Service Workers (and other
	     privileged web APIs) inside WKWebView. Covers the host + subdomains.
	     Only domains are accepted here, so a LAN address can't be listed — the
	     opt-in is applied conditionally, see WebContainer.isAppBound. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>solarflare-tarpon.ts.net</string>
	</array>
</dict>
</plist>
