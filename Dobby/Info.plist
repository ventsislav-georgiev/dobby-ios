<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode's INFOPLIST_KEY_ synthesis silently drops. Synthesized keys
	     (display name, scene manifest, etc.) merge on top of this base. -->
	<!-- No custom/proprietary crypto → skip TestFlight's per-build export-compliance prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- #504: the launch screen is the D mark, static, 120 pt centred on black (LaunchMark.pdf).
	     #508: no loader follows it; the bundled shell loads straight away. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Now Playing Live Activity: lock screen, Dynamic Island, and the CarPlay
	     Dashboard (which renders Live Activities with no CarPlay entitlement). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Type on TV talks to the TV over plain HTTP on the LAN, so cleartext to local
	     hosts must be allowed (#508: the Pi it was first allowed for is retired). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dobby finds Dobby on your TV on the same network, so you can type on it from this device.</string>
	<!-- #248 Type on TV: the in-app scan of the QR the TV's Settings guide shows (iOS only). -->
	<key>NSCameraUsageDescription</key>
	<string>Dobby uses the camera to scan the QR code on your TV, so this phone can send Settings to it.</string>
	<!-- #237 Type on TV: the one service type the TV advertises while Dobby is in front on it. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_dobby-link._tcp</string>
	</array>
	<!-- #464: Sparkle, the DMG's self-update (macOS only; iOS never links Sparkle and ignores
	     these). Values come from build settings, see project.yml; empty in every build but
	     scripts/mac-release.sh, and Updater.swift starts nothing while any is empty. Android
	     parity: a check every 6 h with no first-run prompt, a silent background download,
	     then Updater.swift's Later/Install alert. -->
	<key>SUFeedURL</key>
	<string>$(DOBBY_MAC_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(DOBBY_SPARKLE_ED_KEY)</string>
	<key>DobbyUpdateToken</key>
	<string>$(DOBBY_UPDATE_TOKEN)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- App-Bound Domains: opting in turns on Service Workers (and other
	     privileged web APIs) inside WKWebView. Covers the host + subdomains.
	     Only domains are accepted here, so a LAN address can't be listed — the
	     opt-in is applied conditionally, see WebContainer.isAppBound.
	     #491: DOBBY_PI_HOST (the Pi's https name) comes from the build
	     environment, never this repo; AppConfig.serverURL reads it back.
	     #508: the Pi is retired, but this name is still the ORIGIN the bundled
	     shell and its data live under; it is never contacted. Never change it. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>$(DOBBY_PI_HOST)</string>
	</array>
</dict>
</plist>
